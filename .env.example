# Copy this file to .env and fill in the key. .env is gitignored.

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Use the Gemini API directly (no Google Cloud project needed).
# Set to TRUE only when moving to Vertex AI / Agent Engine (see README, "Why ADK").
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# Gemini model string. Checked against https://ai.google.dev/gemini-api/docs/models
# on 2026-10-05, where gemini-3.8-flash was the newest stable Flash model.
# Re-check that page before the demo; any model that supports structured output works.
GEMINI_MODEL=gemini-3.8-flash

# Optional: tried in order when GEMINI_MODEL answers 503 "high demand" or 429.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.7-flash
